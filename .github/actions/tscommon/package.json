{
  "name": "tscommon",
  "version": "0.0.0",
  "private": true,
  "description": "Library for common utilities for TS Actions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write 'src/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "npm pack",
    "all": "npm ci && npm run format && npm run lint && npm run build",
    "test": "jest"
  },
  "keywords": [
    "file",
    "node"
  ],
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.12.4",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vercel/ncc": "0.38.3",
    "eslint": "10.4.0",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-prettier": "5.2.3",
    "prettier": "3.5.1",
    "ts-jest": "29.2.5",
    "typescript": "6.0.3"
  }
}
